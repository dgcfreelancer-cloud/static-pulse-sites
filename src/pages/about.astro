---
import Layout from '../layouts/Layout.astro';

const values = [
  {
    title: 'Simplicity',
    copy:
      'Technology should reduce complexity rather than give your team more systems, subscriptions, and processes to manage.',
  },
  {
    title: 'Ownership',
    copy:
      'Clients retain ownership of their websites, custom software, source code, approved project files, and business data.',
  },
  {
    title: 'Practical AI',
    copy:
      'AI is introduced only when it creates useful and measurable value inside a real business workflow.',
  },
  {
    title: 'Human Guidance',
    copy:
      'Every project includes direct collaboration and clear explanations without expecting clients to understand programming or technical architecture.',
  },
  {
    title: 'Focused Solutions',
    copy:
      'We solve the defined business problem instead of adding features that do not support the outcome.',
  },
  {
    title: 'Long-Term Flexibility',
    copy:
      'Websites, workflows, and internal systems are built so they can evolve as the business, team, and process change.',
  },
];

const process = [
  {
    number: '01',
    title: 'Start with the problem',
    copy:
      'You explain what is slowing the business down, creating unnecessary work, or preventing the company from operating the way it should.',
  },
  {
    number: '02',
    title: 'Understand the process',
    copy:
      'We review the people, platforms, information, documents, decisions, and steps involved in the current process.',
  },
  {
    number: '03',
    title: 'Design the solution',
    copy:
      'We define the most appropriate website, automation, internal software, or combination of services for the problem.',
  },
  {
    number: '04',
    title: 'Build with feedback',
    copy:
      'You review the work throughout the project so the system can be refined before it is finalized.',
  },
  {
    number: '05',
    title: 'Launch and support',
    copy:
      'We help put the new system into use and can continue improving, maintaining, and expanding it when needed.',
  },
];
---

<Layout
  title="About Static Pulse Sites | Business Systems Studio"
  description="Learn how Static Pulse Sites helps small and medium businesses simplify operations through custom websites, business automation, AI systems, and internal software."
>
  <main class="about-page">
    <section class="about-intro-section">
      <div class="container about-intro">
        <h1>Technology should support the way your business works</h1>

        <p class="about-intro-statement">
          Static Pulse Sites is a Business Systems Studio that helps small and
          medium businesses create simpler, more connected ways of working.
        </p>

        <div class="about-button-row">
          <a class="btn btn-primary" href="/contact">
            Start Your Project
          </a>
        </div>
      </div>
    </section>

    <section class="about-story-section">
      <div class="container about-story-grid">
        <div class="about-story-copy">
          <h2>Why Static Pulse Sites exists</h2>

          <p>
            Static Pulse Sites began with website development after founder
            Daniela Carrion experienced firsthand how difficult it can be to
            manage a website built on a fragile, plugin-dependent platform.
          </p>

          <p>
            Learning how websites work beneath the surface led to a broader
            realization: many businesses face the same problem across their
            entire operation. They have several tools, but those tools do not
            work together. Important processes still depend on spreadsheets,
            manual follow-up, copied information, and disconnected systems.
          </p>

          <p>
            Employees spend time transferring information between platforms,
            searching through folders and inboxes, recreating documents,
            updating the same records in several places, and remembering which
            step should happen next.
          </p>

          <p>
            The company evolved into a Business Systems Studio to address that
            larger problem. Today, Static Pulse Sites combines website
            development, AI systems and workflow automation, and custom
            internal software to help businesses create more organized and
            connected operations.
          </p>

          <p>
            The objective is not to replace every system a business already
            uses or add technology simply because it is available. The
            objective is to understand the problem, improve the process, and
            build the missing connection or tool when it is genuinely needed.
          </p>
        </div>

        <div class="about-photo-wrap">
          <img
            src="/images/ceo-photo.png"
            alt="Daniela Carrion, founder of Static Pulse Sites"
            class="about-photo"
            width="900"
            height="1125"
            loading="eager"
          />

          <div class="about-founder-caption">
            <p class="about-founder-name">Daniela Carrion</p>
            <p>Founder, Static Pulse Sites</p>
          </div>
        </div>
      </div>
    </section>

    <section class="about-section about-approach-section">
      <div class="container">
        <div class="about-centered-heading">
          <h2>Business needs come before technology</h2>

          <p>
            We do not begin projects by choosing a platform, adding AI, or
            recommending new software. We begin by understanding the business
            problem, the people involved, the current process, and the outcome
            the company needs.
          </p>
        </div>

        <div class="about-copy-grid">
          <div>
            <h3>Technology is selected after the process is understood</h3>

            <p>
              A business may believe it needs a new CRM when the actual problem
              is an inconsistent intake process. It may ask for an AI assistant
              when the information employees need is scattered and outdated.
              It may request a new website when the larger issue is that
              enquiries do not connect with the systems used after submission.
            </p>

            <p>
              We examine those underlying conditions before recommending the
              solution. In some cases, the appropriate answer is a custom
              website. In others, it is an automation, an internal tool, or a
              simpler connection between existing platforms.
            </p>
          </div>

          <div>
            <h3>Clients do not need to arrive with a technical plan</h3>

            <p>
              You do not need to know which framework, database, automation
              platform, API, or AI model should be used. Our role is to
              translate the operational problem into a practical technical
              approach and explain the decisions in clear language.
            </p>

            <p>
              Projects remain collaborative. Clients provide the business
              knowledge, priorities, requirements, and feedback. Static Pulse
              Sites provides the planning, implementation, testing, and
              technical guidance required to turn that information into a
              working system.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="about-section about-values-section">
      <div class="container">
        <div class="about-centered-heading">
          <h2>The principles behind every project</h2>

          <p>
            Every website, automation, and internal software project is guided
            by the same standards: simplicity, ownership, useful technology,
            direct collaboration, and a clear connection to the business
            outcome.
          </p>
        </div>

        <div class="about-values-grid">
          {
            values.map((value) => (
              <article class="about-value-card">
                <h3>{value.title}</h3>
                <p>{value.copy}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="about-section">
      <div class="container">
        <div class="about-centered-heading">
          <h2>One studio connecting the public and internal sides of the business</h2>

          <p>
            Static Pulse Sites treats websites, automation, and internal
            software as parts of one connected business system rather than
            three unrelated services.
          </p>
        </div>

        <div class="about-services-grid">
          <article class="about-service-card">
            <h3>Website Development</h3>

            <p>
              The website communicates the business publicly, helps potential
              customers understand the offer, collects useful information, and
              guides visitors toward the appropriate next step.
            </p>

            <a href="/services/website-development">
              Explore Website Development →
            </a>
          </article>

          <article class="about-service-card">
            <h3>AI Systems &amp; Automation</h3>

            <p>
              Automation connects the tools behind the business, reduces
              repetitive administration, improves consistency, and helps
              information move between people and platforms.
            </p>

            <a href="/services/ai-systems-automation">
              Explore AI Systems &amp; Automation →
            </a>
          </article>

          <article class="about-service-card">
            <h3>Custom Internal Software</h3>

            <p>
              Internal software supports the work employees and clients need to
              complete when spreadsheets and generic tools no longer match the
              process properly.
            </p>

            <a href="/services/custom-internal-software">
              Explore Custom Internal Software →
            </a>
          </article>
        </div>
      </div>
    </section>

    <section class="about-section about-process-section">
      <div class="container">
        <div class="about-centered-heading">
          <h2>A collaborative process from problem to launch</h2>

          <p>
            Every engagement begins with what the business needs to improve.
            The technical solution is defined only after the current process,
            constraints, and desired outcome are understood.
          </p>
        </div>

        <ol class="about-process-list">
          {
            process.map((step) => (
              <li>
                <span class="about-process-number">{step.number}</span>

                <div>
                  <h3>{step.title}</h3>
                  <p>{step.copy}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="about-section about-fit-section">
      <div class="container">
        <div class="about-centered-heading">
          <h2>Who Static Pulse Sites works with</h2>

          <p>
            We work with small and medium businesses based on the problem they
            need to solve rather than their industry.
          </p>
        </div>

        <div class="about-fit-grid">
          <div class="about-fit-panel">
            <h3>A strong project fit</h3>

            <ul>
              <li>
                Your team depends on repetitive manual administration.
              </li>
              <li>
                Important information is spread across disconnected tools.
              </li>
              <li>
                Your website does not connect with the process behind it.
              </li>
              <li>
                Spreadsheets or generic platforms no longer support the work.
              </li>
              <li>
                You need a focused system rather than an enterprise platform.
              </li>
              <li>
                You value clear ownership and direct collaboration.
              </li>
            </ul>
          </div>

          <div class="about-fit-panel">
            <h3>Projects outside our current focus</h3>

            <ul>
              <li>
                Large enterprise software replacement programs.
              </li>
              <li>
                Mass-market consumer applications requiring large teams.
              </li>
              <li>
                Complex e-commerce ecosystems with extensive product operations.
              </li>
              <li>
                Projects seeking technology without a defined business problem.
              </li>
              <li>
                Fully automated systems where responsible human review is
                necessary.
              </li>
              <li>
                Work requiring unsupported guarantees about rankings, revenue,
                or AI accuracy.
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="about-final-section">
      <div class="container">
        <div class="about-final-cta">
          <h2>Tell us what you want your business to do more efficiently</h2>

          <p>
            You do not need to arrive with a technical plan. Start by
            describing the current process, what is not working, which tools
            are involved, and the result you want.
          </p>

          <div class="about-button-row">
            <a class="btn btn-primary" href="/contact">
              Start Your Project
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .about-page {
    overflow: hidden;
  }

  .about-intro-section {
    padding: clamp(3.25rem, 5vw, 5rem) 0
      clamp(2.75rem, 4vw, 4rem);
  }

  .about-intro {
    max-width: 1120px;
    text-align: center;
  }

  .about-intro h1 {
    max-width: 980px;
    margin: 0 auto;
    text-wrap: balance;
  }

  .about-intro-statement {
    max-width: 900px;
    margin: 1.5rem auto 0;
    font-family: var(--font-heading);
    font-size: clamp(1rem, 1.5vw, 1.4rem);
    line-height: 1.35;
    color: var(--color-text);
    text-wrap: balance;
  }

  .about-intro-copy {
    max-width: 790px;
    margin: 1.1rem auto 0;
    line-height: 1.7;
  }

  .about-button-row {
    display: flex;
    justify-content: center;
    margin-top: 1.9rem;
  }

  .about-story-section,
  .about-section {
    padding: clamp(2.75rem, 4vw, 4rem) 0;
  }

  .about-story-section,
  .about-values-section,
  .about-ownership-section,
  .about-fit-section {
    background: rgba(255, 255, 255, 0.018);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .about-story-grid {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    gap: 3rem;
    align-items: center;
}

  .about-story-copy h2 {
    margin: 0 0 1.35rem;
    text-wrap: balance;
  }

  .about-story-copy p {
    line-height: 1.72;
  }

  .about-story-copy p + p {
    margin-top: 1.05rem;
  }

  .about-photo-wrap {
  max-width: 430px;
  margin: 0 auto;
  padding: 0.75rem;

  border: 1px solid var(--color-border);
  border-radius: 24px;

  background:
    radial-gradient(circle at top right,
      rgba(6,182,212,.08),
      transparent 45%),
    rgba(255,255,255,.03);
}

.about-photo {
  width: 100%;
  height: auto;
  display: block;
  object-fit: cover;
  border-radius: 18px;
}

  .about-founder-caption {
    padding: 1rem 0.5rem 0.25rem;
  }

  .about-founder-caption p {
    font-size: 0.92rem;
  }

  .about-founder-name {
    margin-bottom: 0.2rem;
    font-family: var(--font-heading);
    font-size: 1.2rem !important;
    color: var(--color-text);
  }

  .about-centered-heading {
    max-width: 1040px;
    margin: 0 auto clamp(2.5rem, 3.5vw, 3.5rem);
    text-align: center;
  }

  .about-centered-heading h2 {
    max-width: 980px;
    margin: 0 auto;
    text-wrap: balance;
  }

  .about-centered-heading > p {
    max-width: 820px;
    margin: 1.15rem auto 0;
    line-height: 1.7;
  }

  .about-copy-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.75rem, 4vw, 4rem);
  }

  .about-copy-grid h3 {
    margin: 0;
  }

  .about-copy-grid p {
    margin-top: 1rem;
    line-height: 1.7;
  }

  .about-values-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.1rem, 2vw, 1.5rem);
  }

  .about-value-card,
  .about-service-card,
  .about-ownership-card,
  .about-fit-panel {
    border: 1px solid var(--color-border);
    border-radius: 22px;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.04),
      rgba(255, 255, 255, 0.015)
    );
  }

  .about-value-card {
    padding: clamp(1.5rem, 2.4vw, 2rem);
  }

  .about-value-card h3,
  .about-service-card h3,
  .about-ownership-card h3,
  .about-fit-panel h3 {
    margin: 0;
  }

  .about-value-card p,
  .about-service-card p {
    margin-top: 0.85rem;
    line-height: 1.65;
  }

  .about-services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.1rem, 2vw, 1.5rem);
  }

  .about-service-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.6rem, 2.5vw, 2.25rem);
  }

  .about-service-card a {
    display: inline-block;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-accent);
    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  .about-service-card a:hover,
  .about-service-card a:focus-visible {
    color: #2ad2ef;
    transform: translateX(4px);
  }

  .about-ownership-layout {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .about-ownership-layout h2 {
    margin: 0;
    text-wrap: balance;
  }

  .about-ownership-layout > div:first-child p {
    margin-top: 1rem;
    line-height: 1.7;
  }

  .about-ownership-card {
    padding: clamp(1.75rem, 3vw, 2.5rem);
  }

  .about-ownership-card ul,
  .about-fit-panel ul {
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .about-ownership-card li,
  .about-fit-panel li {
    position: relative;
    padding: 0.8rem 0 0.8rem 1.75rem;
    color: var(--color-muted);
    border-bottom: 1px solid var(--color-border);
  }

  .about-ownership-card li:first-child,
  .about-fit-panel li:first-child {
    border-top: 1px solid var(--color-border);
  }

  .about-ownership-card li::before,
  .about-fit-panel li::before {
    content: '✓';
    position: absolute;
    left: 0.25rem;
    color: var(--color-accent);
    font-weight: 700;
  }

  .about-process-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .about-process-list li {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .about-process-number {
    padding-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }

  .about-process-list h3 {
    margin: 0;
  }

  .about-process-list p {
    max-width: 900px;
    margin-top: 0.5rem;
    line-height: 1.65;
  }

  .about-fit-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .about-fit-panel {
    padding: clamp(1.75rem, 3vw, 2.5rem);
  }

  .about-fit-panel:nth-child(2) li::before {
    content: '—';
  }

  .about-final-section {
    padding: clamp(2.25rem, 3vw, 3.25rem) 0
      clamp(3rem, 4vw, 4rem);
  }

  .about-final-cta {
    max-width: 1050px;
    margin: 0 auto;
    padding: clamp(2.25rem, 4vw, 3.5rem);
    text-align: center;
    border: 1px solid var(--color-border);
    border-radius: 28px;
    background:
      radial-gradient(
        circle at top right,
        rgba(6, 182, 212, 0.12),
        transparent 38%
      ),
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.045),
        rgba(255, 255, 255, 0.015)
      );
  }

  .about-final-cta h2 {
    max-width: 880px;
    margin: 0 auto;
    text-wrap: balance;
  }

  .about-final-cta > p {
    max-width: 770px;
    margin: 1rem auto 0;
    line-height: 1.7;
  }

  @media (max-width: 960px) {
    .about-story-grid,
    .about-ownership-layout {
      grid-template-columns: 1fr;
    }

    .about-values-grid,
    .about-services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .about-photo-wrap {
      max-width: 620px;
      margin: 0 auto;
    }
  }

  @media (max-width: 680px) {
    .about-intro-section,
    .about-story-section,
    .about-section {
      padding-top: 2.5rem;
      padding-bottom: 2.5rem;
    }

    .about-copy-grid,
    .about-values-grid,
    .about-services-grid,
    .about-fit-grid {
      grid-template-columns: 1fr;
    }

    .about-process-list li {
      grid-template-columns: 48px minmax(0, 1fr);
      gap: 1rem;
    }

    .about-final-section {
      padding-top: 2rem;
      padding-bottom: 3rem;
    }

    .about-final-cta {
      padding: 2rem 1.25rem;
      border-radius: 22px;
    }

    .about-value-card,
    .about-service-card,
    .about-ownership-card,
    .about-fit-panel {
      border-radius: 19px;
    }
  }
</style>