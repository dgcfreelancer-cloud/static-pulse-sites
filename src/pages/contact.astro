---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Static Pulse Sites | Start Your Project"
  description="Contact Static Pulse Sites about custom website development, AI automation, workflow automation, or custom internal software for your business."
>
  <main class="contact-page">
    <section class="contact-section">
      <div class="container contact-container">
        <div class="contact-heading">
          <h1>Start Your Project</h1>

          <p>
            Tell us about your business, what is slowing you down, and what you
            would like to improve. We will review your inquiry and respond by
            email.
          </p>
        </div>

        <form
          class="contact-form"
          action="https://formspree.io/f/xnjyojrv"
          method="POST"
        >
          <div class="form-row">
            <div class="form-field">
              <label for="name">Name *</label>

              <input
                id="name"
                name="name"
                type="text"
                placeholder="Your full name"
                required
              />
            </div>

            <div class="form-field">
              <label for="email">Email *</label>

              <input
                id="email"
                name="email"
                type="email"
                placeholder="you@email.com"
                required
              />
            </div>
          </div>

          <div class="form-row">
            <div class="form-field">
              <label for="company">Company</label>

              <input
                id="company"
                name="company"
                type="text"
                placeholder="Your company"
              />
            </div>

            <div class="form-field">
              <label for="website">Current Website</label>

              <input
                id="website"
                name="website"
                type="url"
                placeholder="https://yourwebsite.com"
              />
            </div>
          </div>

          <div class="form-field">
            <label for="service">What would you like help with? *</label>

            <select id="service" name="service" required>
              <option value="">Select an option</option>

              <option value="Website Development">
                Website Development
              </option>

              <option value="AI Systems and Automation">
                AI Systems &amp; Automation
              </option>

              <option value="Custom Internal Software">
                Custom Internal Software
              </option>

              <option value="Combination of Services">
                Combination of Services
              </option>

              <option value="Not Sure Yet">
                I am not sure yet
              </option>
            </select>
          </div>

          <div class="form-field">
            <label for="current-tools">Current Tools</label>

            <input
              id="current-tools"
              name="current-tools"
              type="text"
              placeholder="Examples: Gmail, Asana, HubSpot, spreadsheets"
            />
          </div>

          <div class="form-field">
            <label for="message">Tell us about your project *</label>

            <textarea
              id="message"
              name="message"
              rows="8"
              placeholder="Describe the current problem, process, website, or system and what you would like to improve."
              required
            ></textarea>
          </div>

          <input
            type="hidden"
            name="_subject"
            value="New Static Pulse Sites project inquiry"
          />

          <input
            type="hidden"
            name="_next"
            value="https://staticpulsesites.com/thank-you"
          />

          <button class="btn btn-primary contact-submit" type="submit">
            Send Project Request
          </button>

          <p class="privacy-note">
            Your information will only be used to review and respond to your
            inquiry.
          </p>
        </form>
      </div>
    </section>
  </main>
</Layout>

<style>
  .contact-page {
    overflow: hidden;
  }

  .contact-section {
    padding: clamp(3.25rem, 5vw, 5rem) 0
      clamp(3rem, 4vw, 4rem);
  }

  .contact-container {
    max-width: 820px;
  }

  .contact-heading {
    max-width: 760px;
    margin: 0 auto 2.5rem;
    text-align: center;
  }

  .contact-heading h1 {
    margin: 0;
  }

  .contact-heading p {
    max-width: 680px;
    margin: 1.15rem auto 0;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .contact-form {
    padding: clamp(1.75rem, 4vw, 3rem);
    border: 1px solid var(--color-border);
    border-radius: 28px;
    background:
      radial-gradient(
        circle at top right,
        rgba(6, 182, 212, 0.1),
        transparent 38%
      ),
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.045),
        rgba(255, 255, 255, 0.015)
      );
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .form-field {
    margin-bottom: 1.25rem;
  }

  .form-field label {
    display: block;
    margin-bottom: 0.5rem;
    font-family: var(--font-body);
    font-weight: 700;
    color: var(--color-text);
  }

  .form-field input,
  .form-field select,
  .form-field textarea {
    width: 100%;
    padding: 0.95rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    outline: none;
    background: rgba(7, 13, 23, 0.45);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1rem;
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .form-field input::placeholder,
  .form-field textarea::placeholder {
    color: rgba(176, 188, 205, 0.7);
  }

  .form-field input:focus,
  .form-field select:focus,
  .form-field textarea:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.12);
  }

  .form-field textarea {
    resize: vertical;
  }

  .contact-submit {
    display: flex;
    width: fit-content;
    margin: 0.5rem auto 0;
  }

  .privacy-note {
    margin-top: 1rem;
    text-align: center;
    font-size: 0.9rem;
  }

  @media (max-width: 680px) {
    .contact-section {
      padding-top: 2.5rem;
      padding-bottom: 3rem;
    }

    .form-row {
      grid-template-columns: 1fr;
    }

    .contact-form {
      padding: 1.5rem;
      border-radius: 22px;
    }

    .contact-submit {
      width: 100%;
    }
  }
</style>