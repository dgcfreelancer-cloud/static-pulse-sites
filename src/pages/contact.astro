---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Start Your Project | Static Pulse Sites"
  description="Contact Static Pulse Sites about website development, AI systems and automation, or custom internal software for your business."
>
  <main>
    <section class="contact-page">
      <div class="container contact-layout">
        <div class="contact-intro">
          <h1>Tell us what you want your business to do more efficiently.</h1>

          <p class="contact-lead">
            You do not need to know which service, platform, or technology you
            need. Start by explaining the current problem, the tools involved,
            and the result you want.
          </p>

          <div class="contact-points">
            <div>
              <p class="card-label">Business First</p>
              <p>We begin with the problem, not the technology.</p>
            </div>

            <div>
              <p class="card-label">Human Guidance</p>
              <p>You will work with a real person throughout the project.</p>
            </div>

            <div>
              <p class="card-label">Clear Ownership</p>
              <p>Your business retains ownership of its systems and data.</p>
            </div>
          </div>

          <div class="contact-help">
            <p class="card-label">What happens next?</p>
            <p>
              We review your request and respond by email with questions,
              recommendations, or the appropriate next step.
            </p>
          </div>
        </div>

        <div class="contact-form-card">
          <div class="contact-form-heading">
            <h2>Start your project.</h2>

            <p>
              Share enough information for us to understand the business
              problem. You can keep the first message simple.
            </p>
          </div>

          <form
            class="contact-form"
            action="https://formspree.io/f/xnjyojrv"
            method="POST"
          >
            <div class="form-row">
              <div class="form-field">
                <label for="name">Name *</label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  placeholder="Your full name"
                  required
                />
              </div>

              <div class="form-field">
                <label for="email">Email *</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  placeholder="you@email.com"
                  required
                />
              </div>
            </div>

            <div class="form-row">
              <div class="form-field">
                <label for="company">Company *</label>
                <input
                  id="company"
                  name="company"
                  type="text"
                  placeholder="Your company"
                  required
                />
              </div>

              <div class="form-field">
                <label for="website">Current Website</label>
                <input
                  id="website"
                  name="website"
                  type="url"
                  placeholder="https://yourwebsite.com"
                />
              </div>
            </div>

            <div class="form-field">
              <label for="service">Service Interested In</label>

              <select id="service" name="service">
                <option value="">Select an option</option>
                <option value="Website Development">
                  Website Development
                </option>
                <option value="AI Systems and Automation">
                  AI Systems &amp; Automation
                </option>
                <option value="Custom Internal Software">
                  Custom Internal Software
                </option>
                <option value="Combination of Services">
                  Combination of Services
                </option>
                <option value="Not Sure Yet">
                  Not Sure Yet
                </option>
              </select>
            </div>

            <div class="form-field">
              <label for="current-tools">Current Tools</label>

              <input
                id="current-tools"
                name="current-tools"
                type="text"
                placeholder="Examples: Gmail, Asana, HubSpot, spreadsheets"
              />
            </div>

            <div class="form-field">
              <label for="message">What would you like to improve? *</label>

              <textarea
                id="message"
                name="message"
                rows="8"
                placeholder="Describe the current problem, process, or system and what you want to improve."
                required
              ></textarea>
            </div>

            <input
              type="hidden"
              name="_subject"
              value="New Static Pulse Sites project inquiry"
            />

            <button class="btn btn-primary contact-submit" type="submit">
              Send Project Request →
            </button>

            <p class="privacy-note">
              Your information will only be used to review and respond to your
              enquiry.
            </p>
          </form>
        </div>
      </div>
    </section>
  </main>
</Layout>