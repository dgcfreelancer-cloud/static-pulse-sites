---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Website Development | Static Pulse Sites"
  description="Fast, secure, low-maintenance websites designed to support your business systems, customer journey, and long-term growth."
>
  <section class="section">
    <div class="container">
      <h1>Website Development</h1>

      <p class="lead hero-lead">
        We build fast, secure, low-maintenance websites that support how your
        business attracts customers, collects information, and connects with
        the systems behind your operations.
      </p>

      <div class="button-row">
        <a class="btn btn-primary" href="/contact">
          Start Your Project
        </a>
      </div>
    </div>
  </section>
</Layout>