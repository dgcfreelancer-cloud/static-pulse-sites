---
import Layout from '../../layouts/Layout.astro';

const benefits = [
  {
    title: 'Custom-Coded Foundation',
    copy:
      'Your website is built around your actual business requirements instead of being forced into a generic template or page-builder structure.',
  },
  {
    title: 'No Plugin Dependency',
    copy:
      'We avoid relying on large collections of third-party plugins that require constant updates and can introduce compatibility or security problems.',
  },
  {
    title: 'Complete Code Ownership',
    copy:
      'Your business retains ownership of the website source code, approved content, connected accounts, and project files.',
  },
  {
    title: 'Fast Loading',
    copy:
      'A lightweight technical foundation helps pages load quickly across desktop and mobile devices without unnecessary scripts or platform features.',
  },
  {
    title: 'Responsive Design',
    copy:
      'Every page is structured and tested to work clearly across desktop computers, tablets, and mobile screens.',
  },
  {
    title: 'Security by Design',
    copy:
      'We reduce unnecessary dependencies, protect access points, and build with a simpler architecture that limits avoidable technical exposure.',
  },
  {
    title: 'SEO-Friendly Structure',
    copy:
      'Pages are built with clear heading hierarchy, metadata, internal linking, readable URLs, image descriptions, and crawlable content.',
  },
  {
    title: 'Forms and Integrations',
    copy:
      'Website forms can connect with email, booking platforms, CRMs, spreadsheets, project-management tools, and automated workflows.',
  },
  {
    title: 'Analytics and Tracking',
    copy:
      'We can configure website analytics and basic conversion tracking so you can understand how people find and use the site.',
  },
  {
    title: 'Long-Term Flexibility',
    copy:
      'The website can evolve as your services, audience, internal systems, and customer journey change.',
  },
  {
    title: 'Clear Content Structure',
    copy:
      'We organize pages around the questions visitors need answered so the website is easier to understand and navigate.',
  },
  {
    title: 'Lower Maintenance Burden',
    copy:
      'A focused website with fewer moving parts generally requires less routine technical intervention than a plugin-heavy platform.',
  },
];

const deliverables = [
  'Business websites and professional service websites',
  'Landing pages for specific offers, campaigns, or audiences',
  'Website rebuilds and migrations from outdated platforms',
  'Contact, enquiry, intake, and qualification forms',
  'Booking and scheduling integrations',
  'CRM and lead-management connections',
  'Email notifications and automated follow-up workflows',
  'Client portal entry points and secure external links',
  'Foundational on-page SEO implementation',
  'Google Analytics and conversion-tracking setup',
  'Mobile optimization and responsive testing',
  'Performance review and image optimization',
  'Domain, hosting, and Cloudflare configuration',
  'Redirect planning when replacing an existing website',
  'Launch support and post-launch maintenance',
];

const process = [
  {
    number: '01',
    title: 'Understand the business',
    copy:
      'We begin with your services, audience, customer journey, current website, internal tools, and the business outcome the new site must support.',
  },
  {
    number: '02',
    title: 'Plan the website',
    copy:
      'We define the page structure, navigation, content requirements, forms, integrations, calls to action, and technical approach before development begins.',
  },
  {
    number: '03',
    title: 'Establish the creative direction',
    copy:
      'We work from your existing brand and references when available. When a new visual direction is required, we create a more detailed design plan before building.',
  },
  {
    number: '04',
    title: 'Build and connect',
    copy:
      'We develop the responsive website, configure forms, connect approved platforms, implement metadata, and prepare the project for testing.',
  },
  {
    number: '05',
    title: 'Review and refine',
    copy:
      'You review the website and provide feedback. We refine the structure, copy placement, visual details, and functionality within the agreed project scope.',
  },
  {
    number: '06',
    title: 'Launch and maintain',
    copy:
      'We publish the website, verify the live experience, and can continue supporting updates, reviews, integrations, and improvements after launch.',
  },
];

const faqItems = [
  {
    question: 'What types of businesses do you build websites for?',
    answer:
      'We build websites for small and medium businesses based on their goals and operational needs rather than their industry. The strongest fit is usually a service-based business that needs a professional website, clear lead pathways, useful integrations, and a simpler technical foundation.',
  },
  {
    question: 'Do I need to provide the website design?',
    answer:
      'No. The starting price is most applicable when you already have branding, examples, content, and a clear creative direction. We can also develop the structure and visual direction from scratch, but that requires additional strategy, design work, and project time.',
  },
  {
    question: 'Can you rebuild my existing website?',
    answer:
      'Yes. We can review the current pages, identify content worth preserving, plan redirects, improve the structure, and rebuild the site on a cleaner foundation. Rebuilds are scoped according to the size and condition of the existing website.',
  },
  {
    question: 'Will I be able to update the site?',
    answer:
      'That depends on how frequently you need to make changes. Some clients prefer a low-maintenance static website with updates handled through an ongoing support arrangement. Others may need an editing interface or connected content system. We recommend the simplest approach that fits the real publishing requirement.',
  },
  {
    question: 'Do you guarantee Google rankings?',
    answer:
      'No responsible provider can guarantee a specific ranking. We can implement a technically sound SEO foundation, improve page structure, map keywords to appropriate pages, and create search-friendly content. Rankings still depend on competition, authority, content quality, relevance, backlinks, and time.',
  },
  {
    question: 'Do you offer website maintenance after launch?',
    answer:
      'Yes. Maintenance can include content edits, new sections, technical reviews, form testing, performance checks, minor integrations, analytics review, and ongoing improvements. The monthly price depends on the amount and frequency of support required.',
  },
];
---

<Layout
  title="Custom Website Development for Small Businesses | Static Pulse Sites"
  description="Custom website development for small businesses, including secure custom-coded websites, responsive design, SEO foundations, integrations, ownership, maintenance, and long-term support."
>
  <main class="website-page">
    <section class="website-hero">
      <div class="container website-hero-inner">
        <h1>Custom Website Development for Small Businesses</h1>

        <p class="website-hero-statement">
          Fast, secure, custom-coded websites designed around your customer
          journey and the systems behind your business.
        </p>

        <p class="website-hero-copy">
          Static Pulse Sites builds professional business websites that explain
          your services clearly, help visitors take action, and connect with the
          tools your team uses to manage leads, clients, bookings, documents,
          and follow-up. Every project is planned around the business outcome
          first, with technology selected to support that goal.
        </p>

        <div class="website-button-row">
          <a class="btn btn-primary" href="/contact">
            Start Your Website Project
          </a>
        </div>
      </div>
    </section>

    <section class="website-image-section" aria-label="Modern business website development">
      <img
        src="/images/modern-business-website-office.jpg"
        alt="Modern office workspace representing custom website development for a small business"
        width="1536"
        height="1024"
        loading="eager"
        fetchpriority="high"
      />
    </section>

    <section class="website-section">
      <div class="container">
        <div class="website-centered-heading">
          <h2>Your website should support the way your business operates</h2>

          <p>
            A professional website is more than an online brochure. It is often
            the first place a potential client encounters your business, the
            starting point of your lead process, and the bridge between your
            public-facing message and your internal systems.
          </p>
        </div>

        <div class="website-copy-grid">
          <div>
            <h3>A clear experience for potential customers</h3>

            <p>
              Visitors should be able to understand what you do, who you help,
              why they should trust you, and what step to take next without
              searching through unnecessary pages. We structure the website
              around those decisions so the experience remains clear on every
              screen.
            </p>

            <p>
              Calls to action, forms, booking links, service pages, pricing
              information, and trust-building content are placed according to
              the customer journey rather than added as disconnected website
              features.
            </p>
          </div>

          <div>
            <h3>A useful entry point to your business systems</h3>

            <p>
              The website can send enquiries into your CRM, notify the correct
              person, create tasks, trigger confirmation emails, route leads,
              collect documents, or begin an onboarding process. These
              connections reduce manual handling and make the website part of a
              larger operational system.
            </p>

            <p>
              We review the platforms you already use before recommending new
              tools. The goal is to create a cleaner process, not add another
              layer of software for your team to manage.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="website-section website-benefits-section">
      <div class="container">
        <div class="website-centered-heading">
          <h2>Benefits of a custom-coded business website</h2>

          <p>
            A focused custom website gives your business greater control over
            performance, ownership, integrations, security, and long-term
            flexibility without relying on a large collection of plugins or a
            restrictive page-building platform.
          </p>
        </div>

        <div class="website-benefits-grid">
          {
            benefits.map((benefit) => (
              <article class="website-card">
                <h3>{benefit.title}</h3>
                <p>{benefit.copy}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="website-section">
      <div class="container">
        <div class="website-split-section">
          <div class="website-split-heading">
            <h2>What our website development services can include</h2>

            <p>
              The exact scope depends on the project, but we can support the
              full path from planning and development through launch,
              integration, and continued maintenance.
            </p>
          </div>

          <ul class="website-check-list">
            {
              deliverables.map((item) => (
                <li>{item}</li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section class="website-section website-foundation-section">
      <div class="container">
        <div class="website-centered-heading">
          <h2>A simpler technical foundation without unnecessary plugin dependence</h2>

          <p>
            Many small business websites are built on platforms that require a
            theme, a database, an administrative login, and numerous plugins to
            perform ordinary functions. That model can be useful when a
            business has advanced publishing requirements, but it can also add
            maintenance, compatibility, and security responsibilities that a
            focused service website does not need.
          </p>
        </div>

        <div class="website-copy-grid">
          <div class="website-text-panel">
            <h3>Why fewer dependencies matter</h3>

            <p>
              Every additional plugin or third-party component introduces
              another system that may require updates, configuration,
              troubleshooting, and compatibility testing. A simpler
              architecture reduces the number of moving parts involved in
              publishing and maintaining the website.
            </p>

            <p>
              This does not mean that any website is maintenance-free or
              completely secure. Domains, hosting, forms, analytics, access
              credentials, and integrations still require responsible
              configuration. The objective is to avoid complexity that does not
              contribute meaningful business value.
            </p>
          </div>

          <div class="website-text-panel">
            <h3>Why ownership matters</h3>

            <p>
              A website should remain a business asset. Clients receive access
              to the project repository, approved files, content, hosting
              configuration, and connected accounts relevant to the website.
            </p>

            <p>
              Clear ownership means the project can be reviewed, maintained, or
              expanded by another qualified developer later. You are not
              required to remain with Static Pulse Sites because the site is
              trapped inside a proprietary system controlled by us.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="website-section">
      <div class="container">
        <div class="website-centered-heading">
          <h2>Foundational SEO built into the website structure</h2>

          <p>
            Search visibility begins with a website that search engines can
            crawl, understand, and connect with the questions potential
            customers are asking. We build the technical and structural
            foundation required for a longer-term SEO strategy.
          </p>
        </div>

        <div class="website-seo-layout">
          <div>
            <h3>General SEO implementation can include</h3>

            <ul class="website-check-list compact">
              <li>Keyword mapping for the primary pages</li>
              <li>SEO titles and meta descriptions</li>
              <li>One clear H1 and logical heading structure</li>
              <li>Readable page URLs</li>
              <li>Internal links between related services and articles</li>
              <li>Descriptive image filenames and alternative text</li>
              <li>Canonical URLs where required</li>
              <li>XML sitemap and robots.txt configuration</li>
              <li>Redirects from replaced or removed URLs</li>
              <li>Basic structured data where appropriate</li>
              <li>Performance and mobile-readability review</li>
              <li>Google Search Console and analytics connections</li>
            </ul>
          </div>

          <div class="website-seo-note">
            <h3>SEO requires more than adding keywords</h3>

            <p>
              A website can provide a strong SEO foundation, but meaningful
              visibility usually requires useful content, appropriate keyword
              targeting, ongoing publishing, internal linking, authority, and
              time. We do not promise rankings or fill pages with repetitive
              phrases simply to make the copy longer.
            </p>

            <p>
              When SEO implementation is included in the project, we organize
              the website around relevant search intent and write or refine the
              page structure so each important service has a clear topic and
              purpose.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="website-section website-process-section">
      <div class="container">
        <div class="website-centered-heading">
          <h2>How the website development process works</h2>

          <p>
            Every project is collaborative. You do not need technical knowledge
            or a complete plan before contacting us, but we will need to
            understand the business, the audience, and the outcome before the
            website is built.
          </p>
        </div>

        <ol class="website-process-list">
          {
            process.map((step) => (
              <li>
                <span class="website-process-number">{step.number}</span>

                <div>
                  <h3>{step.title}</h3>
                  <p>{step.copy}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="website-section website-pricing-section">
      <div class="container">
        <div class="website-centered-heading">
          <h2>Website development pricing</h2>

          <p>
            Custom website development starts at <strong>$1,500</strong>. The
            final price depends on how much strategy, content, design,
            functionality, integration, and SEO work the project requires.
          </p>
        </div>

        <div class="website-pricing-grid">
          <article class="website-pricing-card">
            <p class="website-price-label">Basic project foundation</p>

            <h3>Starting at $1,500</h3>

            <p>
              This starting point is best suited to a focused business website
              where the client already has a clear creative direction,
              branding, approved content, examples of the desired style, and a
              relatively straightforward page structure.
            </p>

            <ul>
              <li>Focused page structure</li>
              <li>Responsive development</li>
              <li>Client-provided visual direction</li>
              <li>Standard contact or enquiry form</li>
              <li>Basic metadata and launch configuration</li>
            </ul>
          </article>

          <article class="website-pricing-card">
            <p class="website-price-label">Custom creative direction</p>

            <h3>Quoted after review</h3>

            <p>
              The investment increases when we need to define the visual
              direction from scratch, reorganize substantial existing content,
              develop new messaging, create custom layouts, source visual
              references, or plan a more complex customer journey.
            </p>

            <ul>
              <li>Creative and structural planning</li>
              <li>Custom page concepts</li>
              <li>Expanded content organization</li>
              <li>Additional review and revision stages</li>
              <li>More complex integrations or functionality</li>
            </ul>
          </article>

          <article class="website-pricing-card">
            <p class="website-price-label">SEO implementation</p>

            <h3>Added according to scope</h3>

            <p>
              General SEO work is priced separately when the project requires
              keyword research, page targeting, metadata across multiple URLs,
              content expansion, redirect planning, technical configuration,
              or a complete search-focused site structure.
            </p>

            <ul>
              <li>Keyword and page mapping</li>
              <li>SEO-focused titles and descriptions</li>
              <li>Content hierarchy and internal linking</li>
              <li>Technical SEO configuration</li>
              <li>Search Console and sitemap setup</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section class="website-section website-maintenance-section">
      <div class="container">
        <div class="website-maintenance-layout">
          <div>
            <h2>Ongoing website maintenance and monthly support</h2>

            <p>
              Launching the website does not have to end the relationship.
              After building or rebuilding your site, Static Pulse Sites can
              continue making approved updates, reviewing functionality, and
              helping the website evolve with the business.
            </p>

            <p>
              Maintenance is offered at a fair monthly price based on the level
              of support required. A business that only needs occasional text
              and image updates will not be priced the same as one that needs
              recurring new sections, technical monitoring, integrations,
              reporting, and monthly strategy reviews.
            </p>
          </div>

          <div class="website-maintenance-card">
            <h3>Monthly support may include</h3>

            <ul class="website-check-list compact">
              <li>Content and image updates</li>
              <li>New page sections or landing pages</li>
              <li>Form and enquiry-flow testing</li>
              <li>Broken-link and redirect review</li>
              <li>Performance and mobile checks</li>
              <li>Analytics and Search Console review</li>
              <li>Minor integrations and workflow changes</li>
              <li>SEO metadata and internal-link updates</li>
              <li>Monthly website review when required</li>
              <li>Priority assistance for agreed maintenance requests</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="website-section website-faq-section">
      <div class="container website-faq-container">
        <div class="website-centered-heading">
          <h2>Frequently asked questions about website development</h2>
        </div>

        <div class="website-faq-list">
          {
            faqItems.map((item) => (
              <details>
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="website-final-section">
      <div class="container">
        <div class="website-final-cta">
          <h2>Build a website your business can own and grow with</h2>

          <p>
            Tell us about your current website, your services, the tools your
            business uses, and what you want the new site to accomplish. You do
            not need to arrive with a technical plan.
          </p>

          <div class="website-button-row">
            <a class="btn btn-primary" href="/contact">
              Start Your Website Project
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .website-page {
    overflow: hidden;
  }

  .website-hero {
    padding: clamp(3.25rem, 5vw, 5rem) 0
      clamp(2.75rem, 4vw, 4rem);
  }

  .website-hero-inner {
    max-width: 1120px;
    text-align: center;
  }

  .website-hero h1 {
    max-width: 980px;
    margin: 0 auto;
    text-wrap: balance;
  }

  .website-hero-statement {
    max-width: 880px;
    margin: 1.5rem auto 0;
    font-family: var(--font-heading);
    font-size: clamp(1.15rem, 2vw, 1.7rem);
    line-height: 1.35;
    color: var(--color-text);
    text-wrap: balance;
  }

  .website-hero-copy {
    max-width: 800px;
    margin: 1.15rem auto 0;
    line-height: 1.7;
  }

  .website-button-row {
    display: flex;
    justify-content: center;
    margin-top: 1.9rem;
  }

  .website-image-section {
    width: 100%;
    height: clamp(260px, 38vw, 520px);
    overflow: hidden;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .website-image-section img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 48%;
    filter: saturate(0.88) contrast(1.04) brightness(0.86);
  }

  .website-section {
    padding: clamp(2.75rem, 4vw, 4rem) 0;
  }

  .website-centered-heading {
    max-width: 1040px;
    margin: 0 auto clamp(2.5rem, 3.5vw, 3.5rem);
    text-align: center;
  }

  .website-centered-heading h2 {
    max-width: 960px;
    margin: 0 auto;
    text-wrap: balance;
  }

  .website-centered-heading > p {
    max-width: 820px;
    margin: 1.15rem auto 0;
    line-height: 1.7;
  }

  .website-centered-heading strong {
    color: var(--color-text);
  }

  .website-copy-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
  }

  .website-copy-grid h3 {
    margin: 0;
  }

  .website-copy-grid p {
    margin-top: 1rem;
    line-height: 1.7;
  }

  .website-benefits-section,
  .website-foundation-section,
  .website-maintenance-section {
    background: rgba(255, 255, 255, 0.018);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .website-benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.1rem, 2vw, 1.5rem);
  }

  .website-card,
  .website-text-panel,
  .website-seo-note,
  .website-pricing-card,
  .website-maintenance-card {
    border: 1px solid var(--color-border);
    border-radius: 22px;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.04),
      rgba(255, 255, 255, 0.015)
    );
  }

  .website-card {
    padding: clamp(1.5rem, 2.4vw, 2rem);
  }

  .website-card h3,
  .website-text-panel h3,
  .website-seo-note h3,
  .website-pricing-card h3,
  .website-maintenance-card h3 {
    margin: 0;
  }

  .website-card p,
  .website-text-panel p,
  .website-seo-note p,
  .website-pricing-card p,
  .website-maintenance-card p {
    margin-top: 0.85rem;
    line-height: 1.65;
  }

  .website-split-section {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .website-split-heading {
    position: sticky;
    top: 120px;
  }

  .website-split-heading h2 {
    margin: 0;
    text-wrap: balance;
  }

  .website-split-heading p {
    margin-top: 1rem;
    line-height: 1.7;
  }

  .website-check-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .website-check-list li {
    position: relative;
    padding: 1rem 1rem 1rem 2rem;
    color: var(--color-muted);
    border-bottom: 1px solid var(--color-border);
  }

  .website-check-list li:nth-child(odd) {
    border-right: 1px solid var(--color-border);
  }

  .website-check-list li::before {
    content: '✓';
    position: absolute;
    left: 0.5rem;
    color: var(--color-accent);
    font-weight: 700;
  }

  .website-check-list.compact {
    grid-template-columns: 1fr;
  }

  .website-check-list.compact li {
    border-right: 0;
  }

  .website-text-panel {
    padding: clamp(1.75rem, 3vw, 2.5rem);
  }

  .website-seo-layout {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
  }

  .website-seo-layout > div:first-child > h3 {
    margin: 0 0 1.5rem;
  }

  .website-seo-note {
    padding: clamp(1.75rem, 3vw, 2.5rem);
    background:
      radial-gradient(
        circle at top right,
        rgba(6, 182, 212, 0.11),
        transparent 42%
      ),
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.04),
        rgba(255, 255, 255, 0.015)
      );
  }

  .website-process-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .website-process-list li {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .website-process-number {
    padding-top: 0.2rem;
