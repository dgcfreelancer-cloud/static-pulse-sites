---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Custom Internal Software | Static Pulse Sites"
  description="Focused internal software built around the way your business manages clients, projects, documents, data, and operations."
>
  <section class="section">
    <div class="container">
      <h1>Custom Internal Software</h1>

      <p class="lead hero-lead">
        We build focused internal tools around your actual process when
        off-the-shelf software cannot solve the problem cleanly.
      </p>

      <div class="button-row">
        <a class="btn btn-primary" href="/contact">
          Start Your Project
        </a>
      </div>
    </div>
  </section>
</Layout>