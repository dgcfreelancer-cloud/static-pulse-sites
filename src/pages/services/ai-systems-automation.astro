---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="AI Systems & Automation | Static Pulse Sites"
  description="Practical AI systems and workflow automation that connect your tools, reduce repetitive work, and improve daily operations."
>
  <section class="section">
    <div class="container">
      <h1>AI Systems & Automation</h1>

      <p class="lead hero-lead">
        We connect your existing tools and automate repetitive processes so
        information moves more reliably and your team spends less time on
        manual work.
      </p>

      <div class="button-row">
        <a class="btn btn-primary" href="/contact">
          Start Your Project
        </a>
      </div>
    </div>
  </section>
</Layout>