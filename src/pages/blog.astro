---
import Layout from '../layouts/Layout.astro';

const posts = [
  {
    title: 'Why WordPress Can Become a Security Liability for Small Businesses',
    description:
      'A practical explanation of plugin dependency, maintenance risks, and when a simpler website architecture may be appropriate.',
    href: '/blog/wordpress-security-vulnerabilities-small-business',
    category: 'Website Development',
  },
  {
    title: 'Beyond Templates: Why Website Ownership Matters for Small Businesses',
    description:
      'How website performance, platform dependency, and code ownership can affect the long-term value of your online presence.',
    href: '/blog/affordable-custom-web-development-small-business',
    category: 'Website Development',
  },
];
---

<Layout
  title="Business Systems Blog | Static Pulse Sites"
  description="Articles about website development, AI systems, workflow automation, custom internal software, and business efficiency."
>
  <main class="blog-page">

    <section class="blog-hero">
      <div class="container blog-hero-content">

        <h1>Practical guidance for building better business systems</h1>

        <p class="hero-lead">
          Explore practical articles about custom websites, business
          automation, AI systems, internal software, and the technology that
          helps small businesses operate more efficiently.
        </p>

      </div>
    </section>

    <section class="blog-section">

      <div class="container">

        <div class="blog-section-heading">
          <h2>Latest articles</h2>

          <p>
            Our current articles focus on website development. Future content
            will also cover workflow automation, AI systems, internal software,
            digital operations, and practical technology for small businesses.
          </p>
        </div>

        <div class="blog-list">

{
posts.map((post) => (

<a
    href={post.href}
    class="blog-row"
    aria-label={`Read ${post.title}`}
>

    <div class="blog-row-content">

        <p class="blog-category">
            {post.category}
        </p>

        <h3>{post.title}</h3>

        <p>{post.description}</p>

    </div>

    <div class="blog-arrow">
        →
    </div>

</a>

))
}

</div>

      </div>

    </section>

    <section class="blog-final">

      <div class="container">

        <div class="blog-cta">

          <h2>Looking for a better way to run your business?</h2>

          <p>
            Whether you need a new website, business automation, or custom
            internal software, we'll help you identify the simplest solution
            for your business.
          </p>

          <div class="button-row">
            <a class="btn btn-primary" href="/contact">
              Start Your Project
            </a>
          </div>

        </div>

      </div>

    </section>

  </main>
</Layout>

<style>
.blog-page{
    overflow:hidden;
}

.blog-hero{
    padding:3.5rem 0 2.5rem;
}

.blog-hero-content{
    max-width:900px;
    margin:auto;
    text-align:center;
}

.blog-hero-content h1{
    max-width:850px;
    margin:auto;
    text-wrap:balance;
}

.blog-hero-content p{
    max-width:760px;
    margin:1.25rem auto 0;
    line-height:1.7;
    font-size:1.1rem;
}

.blog-section{
    padding:2.75rem 0;
}

.blog-section-heading{
    text-align:center;
    max-width:850px;
    margin:0 auto 2.5rem;
}

.blog-section-heading h2{
    margin:0;
}

.blog-section-heading p{
    margin-top:1rem;
    line-height:1.7;
}

.blog-list{
    max-width:1000px;
    margin:auto;

    display:flex;
    flex-direction:column;
    gap:1rem;
}

.blog-row{

    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:2rem;

    padding:2rem;

    border:1px solid var(--color-border);
    border-radius:22px;

    text-decoration:none;
    color:inherit;

    background:
    radial-gradient(circle at top right,
    rgba(6,182,212,.08),
    transparent 35%),
    linear-gradient(
    180deg,
    rgba(255,255,255,.035),
    rgba(255,255,255,.015));

    transition:
        transform .2s ease,
        border-color .2s ease,
        background .2s ease;
}

.blog-row:hover{

    transform:translateY(-3px);

    border-color:var(--color-accent);

    background:
    radial-gradient(circle at top right,
    rgba(6,182,212,.16),
    transparent 35%),
    linear-gradient(
    180deg,
    rgba(255,255,255,.05),
    rgba(255,255,255,.02));

}

.blog-row-content{
    flex:1;
}

.blog-category{
    margin:0 0 .75rem;

    font-family:var(--font-mono);
    font-size:.72rem;
    letter-spacing:.08em;
    text-transform:uppercase;

    color:var(--color-accent);
}

.blog-row h3{
    margin:0;
}

.blog-row p{
    margin-top:.9rem;
    line-height:1.7;
    max-width:760px;
}

.blog-arrow{

    font-size:2rem;
    color:var(--color-accent);

    transition:transform .2s ease;

    flex-shrink:0;
}

.blog-row:hover .blog-arrow{
    transform:translateX(6px);
}

@media(max-width:768px){

.blog-row{
    flex-direction:column;
    align-items:flex-start;
}

.blog-arrow{
    display:none;
}

}

.blog-category{

    margin:0 0 .9rem;

    font-family:var(--font-mono);
    font-size:.72rem;
    letter-spacing:.08em;
    text-transform:uppercase;

    color:var(--color-accent);
}

.blog-card h3{
    margin:0;
}

.blog-card p{
    margin-top:1rem;
    line-height:1.7;
}

.blog-link{

    display:inline-block;

    margin-top:2rem;
    padding-top:1.2rem;

    border-top:1px solid var(--color-border);

    font-family:var(--font-mono);
    font-size:.75rem;
    font-weight:600;

    letter-spacing:.04em;

    color:var(--color-accent);

    transition:
    color .2s ease,
    transform .2s ease;
}

.blog-link:hover{
    transform:translateX(4px);
}

.blog-final{
    padding:2.5rem 0 4rem;
}

.blog-cta{

    max-width:1050px;

    margin:auto;

    padding:3rem;

    text-align:center;

    border:1px solid var(--color-border);
    border-radius:28px;

    background:
    radial-gradient(circle at top right,
    rgba(6,182,212,.10),
    transparent 38%),
    linear-gradient(
    180deg,
    rgba(255,255,255,.04),
    rgba(255,255,255,.015));
}

.blog-cta h2{
    max-width:850px;
    margin:auto;
}

.blog-cta p{
    max-width:760px;
    margin:1rem auto 0;
    line-height:1.7;
}

.button-row{
    display:flex;
    justify-content:center;
    margin-top:1.8rem;
}

@media(max-width:768px){

.blog-grid{
    grid-template-columns:1fr;
}

.blog-section{
    padding:2.25rem 0;
}

.blog-cta{
    padding:2rem 1.5rem;
    border-radius:22px;
}

}
</style>