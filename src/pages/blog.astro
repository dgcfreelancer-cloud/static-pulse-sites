---
import Layout from '../layouts/Layout.astro';

const posts = [
  {
    title: 'Why WordPress Can Become a Security Liability for Small Businesses',
    description:
      'A practical explanation of plugin dependency, maintenance risks, and when a simpler website architecture may be appropriate.',
    href: '/blog/wordpress-security-vulnerabilities-small-business',
    category: 'Website Development',
  },
  {
    title: 'Beyond Templates: Why Website Ownership Matters for Small Businesses',
    description:
      'How website performance, platform dependency, and code ownership can affect the long-term value of your online presence.',
    href: '/blog/affordable-custom-web-development-small-business',
    category: 'Website Development',
  },
];
---

<Layout
  title="Business Systems Blog | Static Pulse Sites"
  description="Articles about website development, AI systems, workflow automation, custom internal software, and business efficiency."
>
  <main>
    <section class="section">
      <div class="container">
        <h1>Practical guidance for building better business systems.</h1>

        <p class="lead hero-lead">
          Explore clear, practical articles about websites, automation, AI,
          internal software, and the systems small and medium businesses use
          every day.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-heading">
          <h2>Latest articles.</h2>

          <p class="lead">
            Our existing articles currently focus on website development.
            Future articles will also cover workflow automation, practical AI,
            internal software, and business operations.
          </p>
        </div>

        <div class="grid-2">
          {
            posts.map((post) => (
              <article class="blog-card">
                <p class="blog-category">{post.category}</p>

                <h2>{post.title}</h2>

                <p>{post.description}</p>

                <a
                  class="text-link"
                  href={post.href}
                  aria-label={`Read ${post.title}`}
                >
                  Read Article →
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="cta-box">
          <h2>Have a business system that needs improvement?</h2>

          <p class="lead">
            Tell us about the website, workflow, or internal process you want
            to make simpler and more effective.
          </p>

          <div class="button-row">
            <a class="btn btn-primary" href="/contact">
              Start Your Project
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>